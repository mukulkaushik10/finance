{
  "name": "control-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"next dev -p 3000\" \"npm run worker\"",
    "build": "next build",
    "start": "concurrently -n web,worker \"next start -p 3000\" \"npm run worker\"",
    "worker": "tsx worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "tamper": "tsx scripts/tamper.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:artifact": "node browser/build.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.1.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "swagger-ui-dist": "^5.27.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
