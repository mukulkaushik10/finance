{
  "name": "Control Room",
  // One container: Node 22 on Debian, with Docker inside it for the Postgres database.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Control Room", "onAutoForward": "openBrowser" }
  },
  // First start: install dependencies (the database and demo data are set up by the start script).
  "postCreateCommand": "npm ci --no-audit --no-fund",
  // Every time you open the codespace: start the database if needed, load demo data once, run the app.
  "postAttachCommand": "bash scripts/codespace-start.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["Prisma.prisma", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] }
  }
}
